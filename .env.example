PORT=3000

# Public origin, advertised as websiteUrl in the agent card and A2MCP manifest.
# The ASP host serves the browser UI as well as the API, so this is normally the same
# value as ASP_BASE_URL. Pointing it at a separate host means anything that host cannot
# serve is still advertised to agents as live.
PUBLIC_BASE_URL=https://asp.zitoai.xyz

# OKX.AI ASP / A2MCP API base
ASP_BASE_URL=https://asp.zitoai.xyz

# OKX Agent Payments Protocol / x402
# ZitoAI is currently a zero-fee x402 ASP so OKX agents can still complete pay-and-replay.
# PAY_TO_ADDRESS should be the Agentic Wallet or recipient address for future paid calls.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
PAY_TO_ADDRESS=
OKX_BASE_URL=https://web3.okx.com
OKX_PAYMENT_NETWORK=eip155:196
OKX_PAYMENT_TOKEN_ADDRESS=0x779ded0c9e1022225f8e0630b35a9b54be713736
OKX_PAYMENT_AMOUNT=0
OKX_PAYMENT_PRICE_USD=0 USDT
OKX_PAYMENT_SYNC_SETTLE=false

# OpenRouter brain
# FAST_MODEL parses and translates the brief; SMART_MODEL ranks the candidate results.
# Both must support strict JSON-schema structured outputs.
#
# Parsing is the harder and higher-stakes job: it decides the language and the English
# query the providers receive. Benchmarked over 120 parses across 20 languages,
# gemini-2.5-flash scored 100% on meaning, asset type and language detection with zero
# run-to-run variance. Ranking only reorders candidates that already exist and is
# validated against them, so it uses the cheaper model from the other provider.
#
# The fallbacks default to each other, so the pair is cross-provider: an outage at one
# vendor costs quality on one call instead of dropping the whole AI layer.
OPENROUTER_API_KEY=
OPENROUTER_FAST_MODEL=google/gemini-2.5-flash
OPENROUTER_SMART_MODEL=openai/gpt-4o-mini
OPENROUTER_FAST_FALLBACK_MODEL=openai/gpt-4o-mini
OPENROUTER_SMART_FALLBACK_MODEL=google/gemini-2.5-flash
OPENROUTER_SITE_URL=https://asp.zitoai.xyz
OPENROUTER_APP_NAME=ZitoAI
OPENROUTER_MAX_CALLS_PER_MINUTE=20
OPENROUTER_MAX_INPUT_CHARS=12000
# Cumulative spend ceiling per process. Defaults to 25 when unset. On reaching it the
# service keeps serving and falls back to the local parser instead of billing further.
OPENROUTER_MAX_SPEND_USD=25

# Per-IP rate limiting for the search routes, which cost provider and model quota.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Durable usage counters, stored in Supabase Postgres.
# Spend accounting is on whenever Supabase is configured: an in-memory total resets on
# every deploy, which makes a cumulative ceiling meaningless.
USAGE_DURABLE_SPEND=true
# The shared rate limiter is off while the service runs a single replica, where the
# in-memory window is correct and avoids a database round trip on every request.
# Turn it on when scaling past one instance.
USAGE_SHARED_RATE_LIMIT=false

# Supabase persistence and private evidence storage
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_EVIDENCE_BUCKET=license-evidence

# OAuth security for provider account connections
# Use the ASP/backend host because provider callbacks hit server routes like /auth/freesound/callback.
OAUTH_CALLBACK_BASE_URL=https://asp.zitoai.xyz
OAUTH_STATE_SECRET=
OAUTH_TOKEN_ENCRYPTION_KEY=

# Shutterstock image licensing
SHUTTERSTOCK_CLIENT_ID=
SHUTTERSTOCK_CLIENT_SECRET=
SHUTTERSTOCK_ACCESS_TOKEN=
SHUTTERSTOCK_API_BASE=https://api.shutterstock.com/v2
# Use https://api-sandbox.shutterstock.com/v2 for safe licensing tests.
SHUTTERSTOCK_AUTHORIZE_URL=https://api.shutterstock.com/v2/oauth/authorize
SHUTTERSTOCK_TOKEN_URL=https://api.shutterstock.com/v2/oauth/access_token
SHUTTERSTOCK_SCOPES=licenses.create licenses.view purchases.view

# Freesound sound effects and ambience
# Search/previews use the API token; OAuth is only needed for uploads/bookmarks/other user actions.
FREESOUND_API_KEY=
FREESOUND_CLIENT_ID=
FREESOUND_CLIENT_SECRET=

# Jamendo music tracks
JAMENDO_CLIENT_ID=
